    { "id": "piano-c4-damper", "event": "release", "sustain": "pedal-up", "pitchSource": "event-note", "triggerMode": "one-shot" },
    { "id": "piano-pedal-down", "event": "pedal-down", "sustain": "pedal-down", "pitchSource": "fixed-root", "triggerMode": "one-shot" },
    { "id": "piano-pedal-up", "event": "pedal-up", "sustain": "pedal-up", "pitchSource": "fixed-root", "triggerMode": "one-shot" }
